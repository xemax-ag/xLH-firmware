	assign OUT[0] = IN[7];	
	assign OUT[1] = IN[6];	
	assign OUT[2] = IN[5];	
	assign OUT[3] = IN[4];	
	assign OUT[4] = IN[3];	
	assign OUT[5] = IN[2];	
	assign OUT[6] = IN[1];
	assign OUT[7] = IN[0];
	//
endmodule
